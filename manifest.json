{
  "manifest_version": 3,
  "name": "LinkedIn Job Summary",
  "version": "1.0.0",
  "description": "Shows required skills, years of experience, and education above every LinkedIn job description.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/*"
      ],
      "js": [
        "src/skills.js",
        "src/extractor.js",
        "src/applicants.js",
        "src/company.js",
        "src/card.js",
        "src/content.js"
      ],
      "css": [
        "src/card.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
